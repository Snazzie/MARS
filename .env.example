# Required for the PostgreSQL-only control plane.
DATABASE_URL=postgres://mars:password@db.example:5432/mars

# Optional immutable default job image references.
DEFAULT_JOB_IMAGE_LINUX_X64=
DEFAULT_JOB_IMAGE_WINDOWS_X64=
DEFAULT_JOB_IMAGE_MACOS_ARM64=

# Optional public HTTPS origin used for GitHub/browser URLs.
PUBLIC_BASE_URL=https://control.example.com
# Optional HTTPS origins workers may use to connect privately.
CONTROL_PLANE_ADAPTER_URLS=https://worker.example.com
BROWSER_BASE_URL=http://localhost:3000

# Optional Cloudflare Tunnel token for the tunnel Compose profile.
CLOUDFLARE_TUNNEL_TOKEN=