# Image tag is selected by the Unraid template; it is not operator environment.
WHITESMITH_BUILD_ID=replace_with_release_id

# Public origins used for GitHub callbacks and browser redirects.
PUBLIC_BASE_URL=https://control-plane.example.com
BROWSER_BASE_URL=https://control-plane.example.com
GITHUB_WEBHOOK_URL=https://control-plane.example.com/api/github/webhook

# PostgreSQL credential. Keep this outside source control.
POSTGRES_PASSWORD=replace_with_database_password

# First administrator GitHub login and OAuth application credentials.
BOOTSTRAP_GITHUB_LOGIN=replace_with_github_login
GITHUB_OAUTH_CLIENT_ID=replace_with_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=replace_with_oauth_client_secret
GITHUB_WEBHOOK_SECRET=replace_with_webhook_secret

# Optional default immutable job image references.
DEFAULT_JOB_IMAGE_LINUX_X64=
DEFAULT_JOB_IMAGE_WINDOWS_X64=
DEFAULT_JOB_IMAGE_MACOS_ARM64=


# Optional adapter URLs and debug behavior.
CONTROL_PLANE_ADAPTER_URLS=
WHITESMITH_DEBUG_PRESERVE_LEASES=0
