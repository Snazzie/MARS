# Mars control-plane deployment inputs.
# Required external PostgreSQL connection.
DATABASE_URL=postgres://mars:password@db.example:5432/mars

# Required canonical browser origin for the control plane. HTTP localhost is
# valid for local OAuth; use HTTPS when browsers access the deployment remotely.
PUBLIC_BASE_URL=http://localhost:3000

# Required public HTTPS origin root for GitHub webhook delivery. Mars appends
# /api/github/webhooks; do not include a path, and do not use localhost/private hosts.
GITHUB_WEBHOOK_URL=https://control.example.com

# Optional single HTTPS worker connection origin. Defaults to PUBLIC_BASE_URL.
WORKER_BASE_URL=

# Optional Cloudflare Tunnel token for the tunnel Compose profile.
CLOUDFLARE_TUNNEL_TOKEN=