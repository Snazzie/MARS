{
  "name": "mars",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "test": "bun test",
    "test:live-job-pickup": "bun run tests/live-job-pickup-smoke.ts",
    "test:windows-container-image": "bun test tests/windows-container-image-contract.test.ts",
    "test:control-plane-proxy": "bun run tests/proxied-control-plane-smoke.ts",
    "test:control-plane-compose": "bash tests/control-plane-compose-smoke.sh",
    "release:verify-worker": "bun run scripts/verify-worker-release.ts",
    "build": "bun run --filter '*' build && bun run build:windows-worker",
    "build:windows-worker": "bun run scripts/build-windows-worker.ts"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "typescript": "latest"
  }
}
