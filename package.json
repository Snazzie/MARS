{
  "name": "whitesmith",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently --kill-others --names control-plane,web \"NODE_ENV=development bun --env-file=.env run --filter @whitesmith/control-plane dev\" \"bun run --filter @whitesmith/web dev\"",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "test": "bun test",
    "test:live-job-pickup": "bun run tests/live-job-pickup-smoke.ts",
    "build": "bun run --filter '*' build"
  },
  "packageManager": "bun@1.2.20",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^10.0.4",
    "typescript": "latest"
  }
}
