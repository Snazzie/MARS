<?xml version="1.0"?>
<Container version="2">
  <Name>Whitesmith Control Plane</Name>
  <Repository>ghcr.io/whitesmith/control-plane:v0.1.0</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>bridge</Network>
  <WebUI>http://[IP]:[PORT:3000]/</WebUI>
  <Privileged>false</Privileged>
  <Support>https://github.com/Snazzie/whitesmith</Support>
  <Project>https://github.com/Snazzie/whitesmith</Project>
  <Overview>Whitesmith control plane. Requires an external PostgreSQL 17 database and an HTTPS reverse proxy with WebSocket support. Worker execution runtimes are external to Unraid.</Overview>
  <Config Name="HTTP Port" Target="3000" Default="3000" Mode="tcp" Description="Control-plane HTTP and WebSocket port." Type="Port" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="Persistent data" Target="/var/lib/whitesmith" Default="/mnt/user/appdata/whitesmith-control-plane/data" Mode="rw" Description="Persistent control-plane diagnostic data." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/whitesmith-control-plane/data</Config>
  <Config Name="App master key" Target="/run/secrets/app_master_key" Default="/mnt/user/appdata/whitesmith-control-plane/app_master_key" Mode="ro" Description="File containing the base64-encoded 32-byte application master key." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/whitesmith-control-plane/app_master_key</Config>
  <Config Name="Database URL" Target="DATABASE_URL" Default="postgres://whitesmith:change-me@postgres:5432/whitesmith" Description="External PostgreSQL connection URL." Type="Variable" Display="always" Required="true" Mask="true">postgres://whitesmith:change-me@postgres:5432/whitesmith</Config>
  <Config Name="Public base URL" Target="PUBLIC_BASE_URL" Default="https://control-plane.example.com" Description="HTTPS origin used for callbacks and API URLs." Type="Variable" Display="always" Required="true" Mask="false">https://control-plane.example.com</Config>
  <Config Name="Browser base URL" Target="BROWSER_BASE_URL" Default="https://control-plane.example.com" Description="Browser-facing HTTPS origin." Type="Variable" Display="always" Required="true" Mask="false">https://control-plane.example.com</Config>
  <Config Name="Bootstrap GitHub login" Target="BOOTSTRAP_GITHUB_LOGIN" Default="" Description="Initial global administrator GitHub login." Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="GitHub OAuth client ID" Target="GITHUB_OAUTH_CLIENT_ID" Default="" Description="GitHub OAuth application client ID." Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="GitHub OAuth client secret" Target="GITHUB_OAUTH_CLIENT_SECRET" Default="" Description="GitHub OAuth application client secret." Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="GitHub webhook secret" Target="GITHUB_WEBHOOK_SECRET" Default="" Description="GitHub webhook signing secret." Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="GitHub webhook URL" Target="GITHUB_WEBHOOK_URL" Default="" Description="Optional GitHub webhook URL." Type="Variable" Display="always" Required="false" Mask="false"></Config>
</Container>
