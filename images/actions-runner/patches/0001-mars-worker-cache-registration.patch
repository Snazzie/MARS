+        private static async Task RegisterMarsCacheAsync(IExecutionContext context, Pipelines.AgentJobRequestMessage message)
+        {
+            var registrationUrl = Environment.GetEnvironmentVariable("MARS_WORKER_CACHE_REGISTRATION_URL");
+            var registrationChallenge = Environment.GetEnvironmentVariable("MARS_WORKER_CACHE_REGISTRATION_CHALLENGE");
+            if (string.IsNullOrEmpty(registrationUrl) && string.IsNullOrEmpty(registrationChallenge))
+            {
+                return;
+            }
+            if (!Uri.TryCreate(registrationUrl, UriKind.Absolute, out var endpoint) ||
+                endpoint.Scheme != Uri.UriSchemeHttps ||
+                string.IsNullOrEmpty(registrationChallenge))
+            {
+                throw new InvalidOperationException("Mars worker cache registration configuration is invalid.");
+            }
+
+            var systemConnection = message.Resources.Endpoints.Single(x => string.Equals(x.Name, WellKnownServiceEndpointNames.SystemVssConnection, StringComparison.OrdinalIgnoreCase));
+            if (systemConnection.Authorization == null ||
+                !systemConnection.Authorization.Parameters.TryGetValue(EndpointAuthorizationParameters.AccessToken, out var runtimeToken) ||
+                string.IsNullOrEmpty(runtimeToken))
+            {
+                throw new InvalidOperationException("GitHub Actions runtime token is unavailable for Mars worker cache registration.");
+            }
+
+            var payload = JsonConvert.SerializeObject(new
+            {
+                challenge = registrationChallenge,
+                runtimeToken,
+                jobId = message.JobId.ToString(),
+                repository = context.GetGitHubContext("repository"),
+            });
+            using var client = new HttpClient();
+            using var request = new HttpRequestMessage(HttpMethod.Post, endpoint)
+            {
+                Content = new StringContent(payload, Encoding.UTF8, "application/json"),
+            };
+            using var response = await client.SendAsync(request, context.CancellationToken);
+            response.EnsureSuccessStatusCode();
+            var responseBody = await response.Content.ReadAsStringAsync();
+            var registration = JsonConvert.DeserializeObject<Dictionary<string, string>>(responseBody);
+            if (registration == null ||
+                !registration.TryGetValue("cacheBaseUrl", out var cacheBaseUrl) ||
+                !Uri.TryCreate(cacheBaseUrl, UriKind.Absolute, out var cacheEndpoint) ||
+                cacheEndpoint.Scheme != Uri.UriSchemeHttps ||
+                cacheEndpoint.UserInfo.Length != 0 ||
+                cacheEndpoint.PathAndQuery != "/")
+            {
+                throw new InvalidOperationException("Mars worker cache registration returned an invalid cache endpoint.");
+            }
+
+            systemConnection.Data["CacheServerUrl"] = cacheEndpoint.AbsoluteUri;
+            systemConnection.Data["ResultsServiceUrl"] = cacheEndpoint.AbsoluteUri;
+            systemConnection.Data["MarsCacheServiceV2"] = bool.TrueString;
+            context.Output("Mars worker cache registration: ready");
+        }
